{
  "name": "flowforge-frontend",
  "version": "0.5.0",
  "description": "Frontend for FlowForge - Visual GitHub Actions Workflow Builder",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src --ext js,jsx,ts,tsx",
    "lint:fix": "eslint src --ext js,jsx,ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
    "clean": "rm -rf dist node_modules/.vite",
    "docker:build": "docker build -f Dockerfile.prod -t flowforge-frontend:latest .",
    "docker:run": "docker run -p 8080:8080 flowforge-frontend:latest"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "axios": "^1.20.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.303.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "braces": "^3.0.3",
    "dompurify": ">=3.4.17",
    "picomatch": ">=4.0.7",
    "postcss-selector-parser": ">=7.1.6",
    "tinypool": ">=2.1.2",
    "@vitest/mocker": ">=5.0.5"
  }
}
